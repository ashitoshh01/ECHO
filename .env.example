# ============================================================================
# ECHO KNOWLEDGE-RISK ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
#
# Copy this file to .env and configure your environment:
# cp .env.example .env
#
# Get your ASI:One API key at: https://asi1.ai/dashboard/api-keys
#
ASI1_API_KEY=

# Model to use: 'asi1' (default), 'asi1-mini', or 'asi1-ultra'
ASI1_MODEL=asi1

# ASI:One API Base URL
ASI1_BASE_URL=https://api.asi1.ai/v1

# Optional GitHub Personal Access Token (for ingesting private repos / higher rate limit)
# GITHUB_TOKEN=

# ============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# ============================================================================
# Frontend URL / Allowed CORS Origins for Render backend
# Multiple origins can be comma-separated:
FRONTEND_URL=https://echo-wecodecoders.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://echo-wecodecoders.vercel.app

# Optional persistent SQLite database path for Render (defaults to backend/echo.db)
# DATABASE_PATH=/var/data/echo.db

# Frontend Vercel Environment Variable (set in Vercel project settings):
# VITE_API_URL=https://YOUR-RENDER-BACKEND-URL.onrender.com


